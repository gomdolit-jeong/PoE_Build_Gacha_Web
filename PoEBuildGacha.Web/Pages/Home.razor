@page "/"
@using PoEBuildGacha.Web.Gacha

<PageTitle>PoE Build Gacha</PageTitle>

@if (flash)
{
    <div class="flash" aria-hidden="true"></div>
}

<main class="shell">
    <header class="hero">
        <h1>PoE Build Gacha</h1>
        <p class="tagline">주사위가 이번 리그 빌드를 정해 드립니다</p>
    </header>

    @if (game is null)
    {
        <section class="panel">
            <h2>어떤 게임을 하시나요?</h2>
            <div class="game-grid">
                <button class="game-card" @onclick="() => game = 1">
                    <span class="game-title">Path of Exile 1</span>
                    <span class="game-sub">빌드 뽑으러 가기</span>
                </button>
                <button class="game-card disabled" disabled>
                    <span class="game-title">Path of Exile 2</span>
                    <span class="badge">개발 예정</span>
                </button>
            </div>
        </section>
    }
    else
    {
        <section class="panel">
            <button class="back" @onclick="Reset" disabled="@rolling">← 게임 다시 고르기</button>
            <h2>Path of Exile 1</h2>

            <div class="roll-form">
                <label class="check">
                    <input type="checkbox" @bind="phrecia" disabled="@rolling" />
                    <span>프레시아 리그 (프레시아 전직 + 이동기 추천)</span>
                </label>

                <div class="dice-stage @(rolling ? "rolling" : landed ? "landed" : "")">
                    <div class="dice-shadow"></div>
                    <div class="dice-bounce">
                        <div class="dice-tilt">
                            <div class="cube" style="transform: rotateX(@(rotX)deg) rotateY(@(rotY)deg)">
                                @for (var face = 1; face <= 6; face++)
                                {
                                    <div class="face face-@face">
                                        @for (var cell = 1; cell <= 9; cell++)
                                        {
                                            <span class="pip @(Pips[face].Contains(cell) ? "on" : "")"></span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <button class="roll" @onclick="Roll" disabled="@rolling">
                    @(rolling ? "굴리는 중..." : "운명 뽑기")
                </button>
            </div>
        </section>

        @if (result is not null)
        {
            <section class="result" style="--class-color: @result.Class.Color">
                <div class="result-head">
                    당신의 운명
                    @if (result.Phrecia)
                    {
                        <span class="badge phrecia">프레시아</span>
                    }
                </div>

                <dl class="cards">
                    <div class="card">
                        <dt>직업</dt>
                        <dd>@result.Class.Korean</dd>
                        <small>@result.Class.Name</small>
                    </div>
                    <div class="card">
                        <dt>전직</dt>
                        <dd>@result.Ascendancy.Korean</dd>
                        <small>@result.Ascendancy.Name</small>
                    </div>
                    <div class="card wide">
                        <dt>주요 스킬</dt>
                        <dd>@result.Skill.Korean</dd>
                        <small>@result.Skill.Name · @PoeData.KindLabel(result.Skill.Kind) 젬</small>
                    </div>
                    @if (result.Movement is not null)
                    {
                        <div class="card wide">
                            <dt>이동기</dt>
                            <dd>@result.Movement.Korean</dd>
                            <small>@result.Movement.Name</small>
                        </div>
                    }
                </dl>

                <p class="hint">마음에 안 들면 한 번 더 굴려 보세요.</p>
            </section>
        }
    }

    <footer class="footer">
        This is a fan project, not affiliated with Grinding Gear Games.
    </footer>
</main>

@code {
    // 3x3 칸 중 눈이 찍히는 칸 (1=왼쪽 위, 9=오른쪽 아래)
    static readonly Dictionary<int, int[]> Pips = new()
    {
        [1] = [5],
        [2] = [1, 9],
        [3] = [1, 5, 9],
        [4] = [1, 3, 7, 9],
        [5] = [1, 3, 5, 7, 9],
        [6] = [1, 3, 4, 6, 7, 9],
    };

    // 각 눈이 정면에 오도록 하는 회전 각도 (X, Y)
    static readonly Dictionary<int, (int X, int Y)> FaceAngles = new()
    {
        [1] = (0, 0),
        [6] = (0, 180),
        [3] = (0, -90),
        [4] = (0, 90),
        [2] = (-90, 0),
        [5] = (90, 0),
    };

    readonly Random rng = new();

    int? game;
    bool phrecia;
    bool rolling;
    bool landed;
    bool flash;
    // 지금까지 돈 바퀴 수 (항상 앞으로만 굴러가도록 계속 쌓습니다)
    int spinX;
    int spinY;
    int rotX;
    int rotY;
    GachaResult? result;

    async Task Roll()
    {
        if (rolling) return;

        rolling = true;
        landed = false;
        result = null;

        // 나올 눈을 먼저 정하고, 여러 바퀴 돈 뒤 그 눈이 정면에서 멈추게 합니다.
        var face = rng.Next(1, 7);
        spinX += 360 * rng.Next(2, 4);
        spinY += 360 * rng.Next(2, 4);
        rotX = spinX + FaceAngles[face].X;
        rotY = spinY + FaceAngles[face].Y;
        StateHasChanged();

        await Task.Delay(1600);

        result = BuildGacha.Roll(phrecia, rng);
        rolling = false;
        landed = true;
        flash = true;
        StateHasChanged();

        await Task.Delay(700);
        flash = false;
    }

    void Reset()
    {
        game = null;
        result = null;
        landed = false;
    }
}
